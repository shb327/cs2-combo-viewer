# Copy to .env.local and adjust.

# The local folder the dev server serves at /assets/ (the pipeline's output). Default: C:/cs2-data/extracted/web
CS2_ASSET_DIR=C:/cs2-data/extracted/web

# Where the assets are served from, if not this site's /assets/ (the local layout). An absolute URL is the hosted
# layout (docs/asset-format.md, "Hosting"): the release comes from <base>release.json.
# VITE_ASSET_BASE=https://assets.combo.skin

# Pin the hosted release in the build instead of reading release.json ("local": keep the local layout).
# VITE_ASSET_RELEASE=

# Public origin of the viewer, for the links it generates (share links, embed). Unset: the page's own origin.
# VITE_WEB_DOMAIN=
