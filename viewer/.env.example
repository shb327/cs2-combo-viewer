# Copy to .env.local and adjust.

# The local folder the dev server serves at /assets/ (the pipeline's output). Default: C:/cs2-data/extracted/web
CS2_ASSET_DIR=C:/cs2-data/extracted/web

# Where the assets are served from, if not this site's /assets/. Must end with "/".
# VITE_ASSET_BASE=/assets/

# Public origin of the viewer, for the links it generates (share links, embed). Unset: the page's own origin.
# VITE_WEB_DOMAIN=
