<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- ValveResourceFormat.20.1.7467.nupkg, from the library's official GitHub release (see pipeline/README.md). -->
    <add key="vrf-release" value="C:\dev\tools\vrf-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="vrf-release">
      <package pattern="ValveResourceFormat" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
