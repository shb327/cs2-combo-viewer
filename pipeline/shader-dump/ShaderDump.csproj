<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>shader-dump</AssemblyName>
    <RootNamespace>ShaderDump</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- From the official ValveResourceFormat 20.1 GitHub release (see pipeline/README.md). -->
    <PackageReference Include="ValveResourceFormat" Version="20.1.7467" />
  </ItemGroup>

</Project>
